  {
   "id": "38c86d46",
   "cell_type": "code",
   "source": [
    "engee.add_line(\"LR15_integrative_measurement\", \"BaselineDelay/Output_1\", \"DelaySum/in_1\")\n",
    "engee.add_line(\"LR15_integrative_measurement\", \"DelayJitter/Output_1\", \"DelaySum/in_2\")\n",
    "engee.add_line(\"LR15_integrative_measurement\", \"DelaySum/main_out\", \"DelayOutput/Input_1\")\n",
    "engee.add_line(\"LR15_integrative_measurement\", \"TelemetrySignal/main_out\", \"TelemetrySum/in_1\")\n",
    "engee.add_line(\"LR15_integrative_measurement\", \"MeasNoise/Output_1\", \"TelemetrySum/in_2\")\n",
    "engee.add_line(\"LR15_integrative_measurement\", \"TelemetrySum/main_out\", \"TelemetryOutput/Input_1\")\n",
    "engee.add_line(\"LR15_integrative_measurement\", \"LossNoise/Output_1\", \"LossOutput/Input_1\")"
   ],
